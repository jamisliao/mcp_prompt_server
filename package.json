    "test": "jest",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "claude",
    "anthropic",
    "prompt",
    "model-context-protocol"
  ],
  "author": "jamisliao",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.0.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "ts-node": "^10.9.1",
    "@types/node": "^18.0.0"
  }
}